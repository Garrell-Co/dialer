#!/bin/bash

set -e

OUTPUT_DIR="${HOME}/bin"

# Function to get the latest version from the directory listing
get_latest_version() {
    echo "Checking for latest Linphone version..." >&2
    # Get directory listing and extract the latest AppImage filename
    LATEST_FILE=$(curl -s "https://download.linphone.org/releases/linux/app/" | \
        grep -oP 'Linphone-[\d.]+(?:-CallEdition)?-x86_64\.AppImage' | \
        sort -V | tail -n 1)
    
    if [ -z "$LATEST_FILE" ]; then
        echo "Error: Could not determine latest version" >&2
        exit 1
    fi
    
    # Extract version number from filename (e.g., "Linphone-6.0.1-CallEdition-x86_64.AppImage" -> "6.0.1")
    echo "$LATEST_FILE" | grep -oP 'Linphone-\K[\d.]+'
}

# If version is specified, use it; otherwise get latest
if [ -n "$1" ]; then
    VERSION="$1"
    # Try both formats: with and without CallEdition
    DOWNLOAD_URL="https://download.linphone.org/releases/linux/app/Linphone-${VERSION}-CallEdition-x86_64.AppImage"
    # Test if this URL exists, if not try without CallEdition
    if ! curl -s --head "$DOWNLOAD_URL" | head -n 1 | grep -q "200 OK"; then
        DOWNLOAD_URL="https://download.linphone.org/releases/linux/app/Linphone-${VERSION}.AppImage"
    fi
else
    echo "Finding latest Linphone version..."
    VERSION=$(get_latest_version)
    # Get the full filename for the latest version
    LATEST_FILE=$(curl -s "https://download.linphone.org/releases/linux/app/" | \
        grep -oP "Linphone-${VERSION}(?:-CallEdition)?-x86_64\.AppImage" | head -n 1)
    DOWNLOAD_URL="https://download.linphone.org/releases/linux/app/${LATEST_FILE}"
    echo "Latest version found: ${VERSION}"
fi

OUTPUT_FILE="${OUTPUT_DIR}/Linphone-${VERSION}.AppImage"

echo "Downloading Linphone ${VERSION}..."
echo "URL: ${DOWNLOAD_URL}"

# Create bin directory if it doesn't exist
mkdir -p "${OUTPUT_DIR}"

# Download the AppImage
echo "Downloading to ${OUTPUT_FILE}..."
curl -L -o "${OUTPUT_FILE}" "${DOWNLOAD_URL}"

# Make it executable (required for AppImages)
chmod +x "${OUTPUT_FILE}"

# Create or update symlink to point to the downloaded version
LATEST_LINK="${OUTPUT_DIR}/linphone"
if [ -L "${LATEST_LINK}" ]; then
    rm "${LATEST_LINK}"
fi
echo "Creating/updating symlink: ${LATEST_LINK} -> ${OUTPUT_FILE}"
ln -s "${OUTPUT_FILE}" "${LATEST_LINK}"

echo "Linphone ${VERSION} downloaded successfully!"
echo "Location: ${OUTPUT_FILE}"
echo "Symlink: ${LATEST_LINK}"
echo ""
echo "To run Linphone:"
echo "  ${OUTPUT_FILE}"
echo "  or"
echo "  ${LATEST_LINK}"

